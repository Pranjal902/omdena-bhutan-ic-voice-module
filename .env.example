# Copy this file to .env in the repo root. Do not commit .env.

# English LLM (Groq) — needed for English_tts.py and voice_assistant English demos
GROQ_API_KEY=your_key_here

# Hugging Face — needed for DZ_asr.py (inference API) and for downloading Jyoti-77/dzongkha-asr
HF_TOKEN=your_huggingface_token_here

# Only needed if you run voice_module/voice_pipelines/Dzongkha/DZ_tts.py
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key_here
